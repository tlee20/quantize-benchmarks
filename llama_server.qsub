#!/bin/bash -l
# Run llama-server on an SCC L40 GPU node in the background (SGE batch job).
#
# Submit:  qsub -v MODEL=./models/Qwen3.5-4B-UD-Q2_K_XL.gguf llama_server.qsub
# Then:    cat llama_server.<jobid>.info     (host, port, tunnel cmd, URL)
#
# Optional env (pass with -v): MODEL, LLAMA_BIN, LLAMA_SERVER, CTX, NGL, ALIAS, EXTRA_ARGS

#$ -N llama_server
#$ -cwd
#$ -l h_rt=4:00:00
#$ -l gpus=1
#$ -l gpu_type=L40S
#$ -pe omp 4
#$ -j y
#$ -o llama_server.$JOB_ID.log

# Paths default to the directory qsub was run from.
WORKDIR="${SGE_O_WORKDIR:-$PWD}"
cd "$WORKDIR"

MODEL="${MODEL:-$WORKDIR/models/Qwen3.5-4B-UD-Q2_K_XL.gguf}"
LLAMA_BIN="${LLAMA_BIN:-$WORKDIR/llama.cpp/build/bin}"
export PATH="$LLAMA_BIN:$PATH"
LLAMA_SERVER="${LLAMA_SERVER:-llama-server}"
CTX="${CTX:-8192}"
NGL="${NGL:-999}"
ALIAS="${ALIAS:-$(basename "$MODEL" .gguf)}"

# Pick a free port on this node (SCC node gets arbitrary port range, so probe).
PORT=$(python3 - <<'EOF'
import socket
s = socket.socket()
s.bind(("", 0))
print(s.getsockname()[1])
s.close()
EOF
)

HOST=$(hostname -f)
INFO="llama_server.${JOB_ID}.info"

cat > "$INFO" <<EOF
host:   $HOST
port:   $PORT
url:    http://$HOST:$PORT/v1
tunnel: ssh -N -L $PORT:$HOST:$PORT <user>@scc1.bu.edu
local:  http://localhost:$PORT/v1   (after tunnel)
model:  $MODEL (alias: $ALIAS)
EOF
cat "$INFO"

nvidia-smi -L

exec "$LLAMA_SERVER" \
  --model "$MODEL" \
  --alias "$ALIAS" \
  --host 0.0.0.0 \
  --port "$PORT" \
  --n-gpu-layers "$NGL" \
  --ctx-size "$CTX" \
  --jinja \
  $EXTRA_ARGS
